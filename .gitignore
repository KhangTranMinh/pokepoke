# --- Gradle / Kotlin ---
.gradle/
build/
!/configs/build/
.kotlin/
.externalNativeBuild/
.cxx/

# --- Local config ---
local.properties

# --- Android Studio / IntelliJ ---
*.iml
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
captures/
.navigation/

# --- Build outputs ---
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# --- Signing ---
*.jks
*.keystore
keystore.properties
# Release signing: never commit (docs/design/build.md §4a)
/configs/signing/release.*
# Shared debug signing key: committed so every machine / CI signs debug builds the same way
!/configs/signing/debug.keystore
# Env secrets: never commit (docs/design/build.md §4b)
/configs/env/secrets.toml

# --- Logs / profiling ---
*.log
*.hprof

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Credentials (never commit) ---
/configs/credentials/
.env
*.env
